# Only used when explicitly passing --jev. Never include keys in market data.
TYPESAFE_API_KEY=

# Kraken SPOT credentials. No withdrawal permission. Never share or commit keys.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Leave empty for dry-run. See KRAKEN_GUIDE.md before opting into real orders.
KRAKEN_ENABLE_LIVE=

#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
started=$SECONDS
bun_version=1.3.10

echo "[setup] Ensuring Bun ${bun_version}"
if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "$bun_version" ]]; then
  # Official versioned installer; never reads or configures application secrets.
  curl -fsSL https://bun.sh/install | BUN_INSTALL="$HOME/.bun" bash -s -- "bun-v${bun_version}"
  export PATH="$HOME/.bun/bin:$PATH"
  # Make the installed tool available to subsequent non-interactive login shells.
  marker='# JevFlow Bun toolchain'
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n%s\nexport PATH="$HOME/.bun/bin:$PATH"\n' "$marker" >> "$HOME/.bash_profile"
  fi
fi
[[ "$(bun --version)" == "$bun_version" ]]

echo "[setup] Installing locked dependencies"
time bun install --frozen-lockfile
echo "[setup] Ready in $((SECONDS - started))s. Run bun test or bun run demo."
